# Copia este archivo como ".env" en la raíz del proyecto y rellena los valores.
# Node lo carga de forma nativa (--env-file), no hace falta ninguna librería.

# API key de Fish Audio. Sin ella, generar audio, clonar voces y añadir voces
# compartidas nuevas se deshabilitan (con un aviso claro en el frontend); el
# resto de la aplicación (favoritos, historial, voces compartidas ya
# guardadas) funciona igual sin ella. Consíguela en https://fish.audio/app/api-keys
FISH_API_KEY=tu_api_key_aqui

# API key de DeepSeek (opcional). Solo si la rellenas aparece en el frontend el
# botón "Mejorar con IA" para añadir marcadores de emoción al texto antes de
# generar el audio. Consíguela en https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Puerto en el que escucha el backend
PORT=4000
