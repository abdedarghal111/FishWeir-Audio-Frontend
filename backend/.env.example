# Copia este archivo como ".env" en esta misma carpeta y rellena los valores.
# Node lo carga de forma nativa (--env-file), no hace falta ninguna librería.

# API key de Fish Audio. Consíguela en https://fish.audio/app/api-keys
FISH_API_KEY=tu_api_key_aqui

# Puerto en el que escucha el backend
PORT=4000
